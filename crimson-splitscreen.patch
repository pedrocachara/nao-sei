diff --git a/src/CrimsonSplitScreen.cpp b/src/CrimsonSplitScreen.cpp
new file mode 100644
index 0000000..7e2146e
--- /dev/null
+++ b/src/CrimsonSplitScreen.cpp
@@ -0,0 +1,224 @@
+#include "CrimsonSplitScreen.hpp"
+
+#include <cstring>
+#include <memory>
+#include <d3d11.h>
+
+#include "Utility/Detour.hpp"
+#include "Vars.hpp"
+#include "Config.hpp"
+#include "CrimsonConfig.hpp"
+#include "Global.hpp"
+
+// =============================================================================
+// HOW TO FINISH THIS (the part that needs the game running)
+//
+// 1. Find the game function that renders the 3D scene once per frame.
+//    - Capture a frame with RenderDoc and look at the first draw call of the
+//      world (not the HUD). Walk up the call stack in x64dbg from there.
+//    - The renderer object is Devil3::sRender at dmc3.exe+C0B410 (see
+//      CrimsonEfk.cpp), and the draw wrapper at dmc3.exe+43F90 is already known.
+//      The scene function is somewhere above those.
+// 2. Put its RVA in SCENE_RENDER_OFFSET and fix SceneRenderFn to its real
+//    signature (a wrong signature breaks the call. Floats, for example, are
+//    passed in xmm registers and would be lost by the 4 pointer arguments below).
+// 3. Check the points marked UNVERIFIED below.
+// =============================================================================
+
+namespace {
+
+// RVA of the game's "render 3D scene" function. 0 = not found yet = hook is NOT installed.
+// TODO: fill in after reverse engineering (see above).
+constexpr uintptr_t SCENE_RENDER_OFFSET = 0;
+
+// TODO: replace with the real signature once known.
+using SceneRenderFn = __int64(__fastcall*)(void*, void*, void*, void*);
+
+std::unique_ptr<Utility::Detour_t> s_sceneRenderHook;
+bool s_insidePass = false; // the scene function may be re-entered by our own passes
+
+// Camera object (cCameraControl in CrimsonEfk.cpp). The pointer lives at dmc3.exe+C8FBD0.
+// Offsets taken from the static_asserts in CrimsonEfk.cpp.
+constexpr size_t CAM_STATE_BEGIN = 0x10; // up
+constexpr size_t CAM_EYE         = 0x70; // vec4
+constexpr size_t CAM_LOOKAT      = 0x80; // vec4
+constexpr size_t CAM_STATE_END   = 0x90; // everything from 0x10 to 0x90 is saved and restored
+                                         // (up, FOV, roll, transform, eye, lookat). The vtable
+                                         // pointer at 0x0 is never touched.
+
+struct CameraSnapshot {
+    uint8 bytes[CAM_STATE_END - CAM_STATE_BEGIN];
+};
+
+byte8* GetGameCamera() {
+    if (!appBaseAddr) {
+        return nullptr;
+    }
+    return *reinterpret_cast<byte8**>(appBaseAddr + 0xC8FBD0);
+}
+
+void SaveCamera(byte8* cam, CameraSnapshot& snapshot) {
+    std::memcpy(snapshot.bytes, cam + CAM_STATE_BEGIN, sizeof(snapshot.bytes));
+}
+
+void RestoreCamera(byte8* cam, const CameraSnapshot& snapshot) {
+    std::memcpy(cam + CAM_STATE_BEGIN, snapshot.bytes, sizeof(snapshot.bytes));
+}
+
+bool GetPlayerPosition(uint8 playerIndex, vec4& position) {
+    auto& playerData = GetPlayerData(playerIndex);
+    auto& newActorData = GetNewActorData(playerIndex, playerData.characterIndex, ENTITY::MAIN);
+    if (!newActorData.baseAddr) {
+        return false;
+    }
+    position = reinterpret_cast<PlayerActorData*>(newActorData.baseAddr)->position;
+    return true;
+}
+
+// Moves the camera so it frames another player the same way it frames the anchor
+// player: the offset between camera and anchor player is kept and applied to the
+// other player. Works for the third person camera (the Crimson forced TPS camera).
+// Fixed cameras (the original Capcom ones) would need their own handling.
+//
+// UNVERIFIED: this only moves eye and lookat. If the renderer builds the view matrix from
+// `transform` (cam + 0x30) instead of recomputing it from eye/lookat every frame, the
+// translation part of `transform` has to be moved too.
+void ShiftCamera(byte8* cam, const vec4& anchorPosition, const vec4& playerPosition) {
+    const float dx = playerPosition.x - anchorPosition.x;
+    const float dy = playerPosition.y - anchorPosition.y;
+    const float dz = playerPosition.z - anchorPosition.z;
+
+    auto* eye = reinterpret_cast<vec4*>(cam + CAM_EYE);
+    auto* lookat = reinterpret_cast<vec4*>(cam + CAM_LOOKAT);
+
+    eye->x += dx;
+    eye->y += dy;
+    eye->z += dz;
+
+    lookat->x += dx;
+    lookat->y += dy;
+    lookat->z += dz;
+}
+
+// The hook: draws the scene once per screen.
+//
+// KNOWN PROBLEMS to check once the hook is live:
+//  - If the scene function clears render targets / depth at its start, every pass
+//    erases the previous one (ClearRenderTargetView ignores the viewport). The clear
+//    then has to be skipped for passes after the first, or limited to the screen rect.
+//  - The game may call RSSetViewports itself inside the scene function, overriding ours.
+//    If so, hook the game's own viewport setup and replace the rect there.
+//  - UNVERIFIED: g_renderSize is used as the full size. If the 3D scene is drawn into an
+//    offscreen render target of another size (Devil3::sRender::renderTargets), use that size.
+//  - UNVERIFIED: ::D3D11::deviceContext is assumed to be the same immediate context the
+//    game renders with (Devil3::sRender::deviceContext).
+//  - The projection aspect ratio is not corrected yet (each screen is wider or narrower
+//    than the full window). Fix FOV or aspect per screen once the projection setup is found.
+__int64 __fastcall SceneRenderDetour(void* a1, void* a2, void* a3, void* a4) {
+    uintptr_t trampolineRaw = s_sceneRenderHook->GetTrampoline();
+    auto original = reinterpret_cast<SceneRenderFn>(trampolineRaw);
+
+    if (s_insidePass || !CrimsonSplitScreen::IsActive()) {
+        return original(a1, a2, a3, a4);
+    }
+
+    byte8* cam = GetGameCamera();
+    ID3D11DeviceContext* context = ::D3D11::deviceContext;
+    vec4 anchorPosition{};
+    if (!cam || !context || !GetPlayerPosition(0, anchorPosition)) {
+        return original(a1, a2, a3, a4);
+    }
+
+    const uint8 screenCount = CrimsonSplitScreen::GetScreenCount();
+
+    UINT oldViewportCount = D3D11_VIEWPORT_AND_SCISSORRECT_OBJECT_COUNT_PER_PIPELINE;
+    D3D11_VIEWPORT oldViewports[D3D11_VIEWPORT_AND_SCISSORRECT_OBJECT_COUNT_PER_PIPELINE];
+    context->RSGetViewports(&oldViewportCount, oldViewports);
+
+    CameraSnapshot savedCamera;
+    SaveCamera(cam, savedCamera);
+
+    __int64 result = 0;
+    s_insidePass = true;
+
+    for (uint8 screen = 0; screen < screenCount; ++screen) {
+        // Start every pass from the original camera, then move it for this player.
+        RestoreCamera(cam, savedCamera);
+
+        vec4 playerPosition{};
+        if (screen > 0 && GetPlayerPosition(screen, playerPosition)) {
+            ShiftCamera(cam, anchorPosition, playerPosition);
+        }
+
+        const auto rect = CrimsonSplitScreen::GetScreenRect(screen, screenCount, g_renderSize.x, g_renderSize.y);
+        D3D11_VIEWPORT viewport{};
+        viewport.TopLeftX = rect.x;
+        viewport.TopLeftY = rect.y;
+        viewport.Width = rect.width;
+        viewport.Height = rect.height;
+        viewport.MinDepth = 0.0f;
+        viewport.MaxDepth = 1.0f;
+        context->RSSetViewports(1, &viewport);
+
+        result = original(a1, a2, a3, a4);
+    }
+
+    s_insidePass = false;
+
+    // Leave the game exactly as it was.
+    RestoreCamera(cam, savedCamera);
+    context->RSSetViewports(oldViewportCount, oldViewports);
+
+    return result;
+}
+
+} // namespace
+
+namespace CrimsonSplitScreen {
+
+bool IsActive() {
+    return activeCrimsonConfig.System.splitScreen && activeConfig.Actor.playerCount > 1 && InGame();
+}
+
+uint8 GetScreenCount() {
+    if (!IsActive()) {
+        return 1;
+    }
+    const uint8 players = activeConfig.Actor.playerCount;
+    return (players > PLAYER_COUNT) ? PLAYER_COUNT : players;
+}
+
+ScreenRect GetScreenRect(uint8 screenIndex, uint8 screenCount, float fullWidth, float fullHeight) {
+    if (screenCount <= 1) {
+        return { 0.0f, 0.0f, fullWidth, fullHeight };
+    }
+
+    if (screenCount == 2) {
+        // top / bottom
+        const float halfHeight = fullHeight * 0.5f;
+        return { 0.0f, halfHeight * screenIndex, fullWidth, halfHeight };
+    }
+
+    // 3 or 4 screens: quadrants
+    const float halfWidth = fullWidth * 0.5f;
+    const float halfHeight = fullHeight * 0.5f;
+    const uint8 column = screenIndex % 2;
+    const uint8 row = screenIndex / 2;
+    return { halfWidth * column, halfHeight * row, halfWidth, halfHeight };
+}
+
+void Init() {
+    if (SCENE_RENDER_OFFSET == 0) {
+        Log("CrimsonSplitScreen: scene render function address not set yet, hook not installed.");
+        return;
+    }
+
+    s_sceneRenderHook = std::make_unique<Utility::Detour_t>(
+        (uintptr_t)appBaseAddr + SCENE_RENDER_OFFSET,
+        (uintptr_t)&SceneRenderDetour,
+        NULL,
+        "split_screen_scene_render");
+    s_sceneRenderHook->Toggle();
+}
+
+} // namespace CrimsonSplitScreen
diff --git a/src/CrimsonSplitScreen.hpp b/src/CrimsonSplitScreen.hpp
new file mode 100644
index 0000000..d395b46
--- /dev/null
+++ b/src/CrimsonSplitScreen.hpp
@@ -0,0 +1,50 @@
+#pragma once
+#include "Core/Core.hpp"
+
+// =============================================================================
+// Local multiplayer split screen (WORK IN PROGRESS)
+//
+// Idea: for every frame, render the 3D scene once per player. Each pass gets
+//   1. its own viewport (a slice of the window), and
+//   2. its own camera, so that every player sees the game "as if they were
+//      player 1".
+// Game logic (CrimsonOnTick, actors, camera updates) must still run only once.
+//
+// What is done here:
+//   - the option (System.splitScreen) and its menu toggle
+//   - screen layout (1/2/3/4 screens) -> GetScreenRect()
+//   - save / move / restore of the game's camera object per pass
+//   - the render hook that repeats the scene pass
+//
+// What is NOT done yet (needs reverse engineering, see CrimsonSplitScreen.cpp):
+//   - the address (and exact signature) of the game's "render the 3D scene"
+//     function. Until SCENE_RENDER_OFFSET is filled in, Init() does nothing and
+//     the game behaves exactly as before.
+//   - aspect ratio / projection per screen
+//   - HUD, effects (Effekseer) and post processing per screen
+// =============================================================================
+
+namespace CrimsonSplitScreen {
+
+struct ScreenRect {
+    float x;
+    float y;
+    float width;
+    float height;
+};
+
+/// True when the option is on, there are 2+ players and the game is in a gameplay scene.
+bool IsActive();
+
+/// Number of screens that will be drawn this frame (1 when not active).
+uint8 GetScreenCount();
+
+/// Rectangle (in pixels, inside the full render size) used by one screen.
+/// 2 players: top / bottom. 3 or 4 players: quadrants (the 4th quadrant stays empty with 3).
+ScreenRect GetScreenRect(uint8 screenIndex, uint8 screenCount, float fullWidth, float fullHeight);
+
+/// Installs the scene render hook. Safe to call at startup: it is a no-op until
+/// the game's scene render function address is known.
+void Init();
+
+} // namespace CrimsonSplitScreen
